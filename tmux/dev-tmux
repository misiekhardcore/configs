#!/bin/bash
# Launch a dev tmux session with Claude Code + shell panes
# Usage: dev-tmux [project-dir]

DIR="${1:-$(pwd)}"
SESSION="dev"

# If session already exists, attach to it
if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux attach-session -t "$SESSION"
  exit 0
fi

# Create session (pane 0 — full width, will become Claude #1)
tmux new-session -d -s "$SESSION" -c "$DIR" -x "$(tput cols)" -y "$(tput lines)"

# Ensure config is loaded (in case server started before config existed)
tmux source-file ~/.tmux.conf 2>/dev/null

# Split bottom shell pane (full width, 30% height)
tmux split-window -v -t "$SESSION:0.0" -c "$DIR" -p 30

# Split top pane horizontally for Claude #2
tmux split-window -h -t "$SESSION:0.0" -c "$DIR"

# Launch Claude in the two top panes
tmux send-keys -t "$SESSION:0.0" "claude" Enter
tmux send-keys -t "$SESSION:0.1" "claude" Enter

# Select Claude #1
tmux select-pane -t "$SESSION:0.0"

# Attach
tmux attach-session -t "$SESSION"
